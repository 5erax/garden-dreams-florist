{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": { "api/storefront.js": { "includeFiles": "dist/index.html" } },
  "rewrites": [
    { "source": "/", "destination": "/api/storefront?path=/" },
    { "source": "/hoa/:slug", "destination": "/api/storefront?path=/hoa/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/storefront?path=/sitemap.xml" }
  ],
  "headers": [
    { "source": "/flowers/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
